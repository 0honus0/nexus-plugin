[
  {
    "id": "@nexus-terminal/ssh",
    "versions": [
      {
        "package": {
          "name": "@nexus-terminal/ssh",
          "version": "0.0.1",
          "type": "module",
          "description": "SSH connections, terminals, commands, SFTP and port forwarding",
          "files": [
            "dist"
          ],
          "exports": {
            "./ssh-api": {
              "types": "./dist/node/ssh-api.d.ts"
            }
          },
          "peerDependencies": {
            "nexus-terminal": "^1.2.0"
          },
          "engines": {
            "node": ">=26.13.1"
          },
          "nexus": {
            "kind": "extension",
            "icon": "terminal",
            "entry": {
              "backend": "dist/node/index.js"
            },
            "i18n": {
              "zh-CN": {
                "description": "提供 SSH 连接、终端、命令执行、SFTP 和端口转发"
              }
            }
          },
          "scripts": {
            "build": "node scripts/build.mjs",
            "typecheck": "tsc -p tsconfig.json",
            "test": "pnpm build && tsx --test tests/*.test.ts"
          }
        },
        "distributions": [
          {
            "tarball": "https://github.com/0honus0/nexus-plugin/releases/download/ssh/v0.0.1/ssh-0.0.1.tgz",
            "integrity": "sha512-T8f036BYnCE4HoNDXokXaaWk82zUm7a8pBn1O3svf99Y8NXX4nf2kLi0KqKX7tNjwTMunVfbAZXEs80SFh7FyQ=="
          }
        ]
      }
    ]
  },
  {
    "id": "@nexus-terminal/oidc",
    "versions": [
      {
        "package": {
          "name": "@nexus-terminal/oidc",
          "version": "0.0.1",
          "type": "module",
          "description": "Sign in with an OpenID Connect provider",
          "displayName": "OpenID Connect",
          "files": [
            "dist"
          ],
          "peerDependencies": {
            "nexus-terminal": "^1.2.0"
          },
          "engines": {
            "node": ">=26.13.1"
          },
          "nexus": {
            "kind": "application",
            "icon": "shield-check",
            "entry": {
              "backend": "dist/node/index.js",
              "frontend": "dist/browser/index.js"
            },
            "authMethods": true,
            "i18n": {
              "zh-CN": {
                "description": "使用 OpenID Connect 身份提供方登录",
                "displayName": "OpenID Connect"
              }
            }
          },
          "scripts": {
            "build": "node ../../scripts/build-plugin.mjs",
            "test:setup": "playwright install --with-deps chromium",
            "typecheck": "vue-tsc --noEmit",
            "test": "pnpm build && vitest run"
          }
        },
        "distributions": [
          {
            "tarball": "https://github.com/0honus0/nexus-plugin/releases/download/oidc/v0.0.1/oidc-0.0.1.tgz",
            "integrity": "sha512-g21szjn2xxKRuSd4dIhUbyBpqJx9zCQNvaycYZN/SpB545hEaPDXjiw3m6Rt1hJbLDmvkxcJFIUWUi0mP55YwA=="
          }
        ]
      }
    ]
  },
  {
