{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@nexus-terminal/workspace/file-manager-api": ["../workspace/src/browser/file-manager-api.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue"]
}
