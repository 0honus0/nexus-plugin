{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist/types",
    "paths": {
      "@nexus-terminal/connections/connections-api": ["../connections/dist/types/node/connections-api.d.ts"],
      "@nexus-terminal/connections/connections-client-api": [
        "../connections/dist/types/browser/connections-client-api.d.ts"
      ],
      "@nexus-terminal/credentials/credentials-api": ["../credentials/dist/types/node/credentials-api.d.ts"],
      "@nexus-terminal/credentials/credentials-client-api": [
        "../credentials/dist/types/browser/credentials-client-api.d.ts"
      ],
      "@nexus-terminal/ssh/ssh-api": ["../ssh/dist/types/node/ssh-api.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue"]
}
